<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saad Topup"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC"
            android:gravity="center"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="SMS Gateway  •  v5.2"
            android:textSize="13sp"
            android:textColor="#94A3B8"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:background="#1E293B">

            <TextView
                android:id="@+id/onlineDot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="#22C55E" />

            <TextView
                android:id="@+id/onlineLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="ONLINE"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#16A34A"
                android:letterSpacing="0.08" />

            <Button
                android:id="@+id/onlineBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Go Offline"
                android:textSize="12sp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:background="#FEE2E2"
                android:textColor="#B91C1C" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="16dp"
            android:background="#ECFDF5"
            android:textColor="#134E4A"
            android:textSize="13.5sp"
            android:lineSpacingExtra="3dp"
            android:fontFamily="monospace"
            android:text="Status loading..." />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:background="#1E293B"
            android:text="Online থাকলে প্রতি ৩ মিনিটে অদৃশ্য অটো স্ক্যান\nশুধু Money Received / Cash In যাবে\nস্ক্যান হচ্ছে কিনা ফোনে দেখা যাবে না"
            android:textColor="#CBD5E1"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="SETUP"
            android:textSize="12sp"
            android:textColor="#64748B"
            android:letterSpacing="0.12" />

        <Button
            android:id="@+id/permissionBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="1. Allow SMS Permission"
            android:textColor="#FFFFFF"
            android:background="#3B82F6"
            android:textSize="14sp" />

        <Button
            android:id="@+id/batteryBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="2. Battery  Unrestricted"
            android:textColor="#FFFFFF"
            android:background="#8B5CF6"
            android:textSize="14sp" />

        <Button
            android:id="@+id/scanBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="Manual Scan (optional)"
            android:textColor="#0F172A"
            android:background="#E2E8F0"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="TIPS"
            android:textSize="12sp"
            android:textColor="#64748B"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:padding="12dp"
            android:background="#1E293B"
            android:text="• Online = auto scan every 3 min (invisible)\n• Status এ Last auto scan time দেখা যাবে\n• Force Stop করবেন না\n• Battery Unrestricted + Autostart চালু রাখুন"
            android:textColor="#94A3B8"
            android:textSize="12.5sp"
            android:lineSpacingExtra="5dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp"
            android:text="Privacy  •  শুধু Amount + TxnID পাঠায়"
            android:textColor="#475569"
            android:textSize="11sp"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
